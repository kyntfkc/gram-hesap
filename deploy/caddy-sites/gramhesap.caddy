gramhesap.indigotaki.net {
	encode zstd gzip

	handle {
		reverse_proxy gram-hesap-app-1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Eski adres; indigotaki.app 2026-11-10'da bitiyor, o zamana kadar yönlendirir
gramhesap.indigotaki.app {
	redir https://gramhesap.indigotaki.net{uri} 308
}
